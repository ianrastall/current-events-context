# Auto detect text files and perform LF normalization
* text=auto

# Generated synthesis and verification artifacts have an explicit LF contract.
expanded/**/*.yaml text eol=lf
provisional/captures/**/*.yaml text eol=lf
reference/reconciliation/extraction-report.json -text

# Cached source payloads: keep exact bytes so recorded SHA-256 values stay valid
reference/expansion/wikitext/*.wiki -text
reference/expansion/authored/**/*.yaml -text
reference/reconciliation/published-HANDOFF.md -text
reference/sources/wikipedia/wikitext/*.wiki -text
reference/sources/wikipedia/rendered_html/*.html -text
reference/sources/wikipedia/** -text

# Annual database containers retain exact binary bytes.
archive/*.sqlite -text
archive/*.md text eol=lf
/[0-9][0-9][0-9][0-9]/*.sqlite -text
/[0-9][0-9][0-9][0-9]/*.md text eol=lf
/[0-9][0-9][0-9][0-9]/SHA256SUMS text eol=lf
reference/yearbook/*.py text eol=lf
reference/yearbook/*.txt text eol=lf

# Replay checks compare embedded implementation bytes across platforms.
seed/*.py text eol=lf
requirements.txt text eol=lf
reference/schema/*.json text eol=lf
reference/schema/*.sql text eol=lf
reference/schema/ANNUAL_ARCHIVE.md text eol=lf
reference/schema/YEARBOOK.md text eol=lf
reference/schema/PRESERVATION_RELEASE.md text eol=lf
reference/overrides/*.json text eol=lf
# This historical acquisition module has mixed line endings in the captured
# pipeline; preserve them until an explicit pipeline migration normalizes it.
seed/wikipedia.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

tools/*.py text eol=lf
PRIMER.txt text eol=lf

# Successor annual edition snapshots and exact source fixtures.
reference/schema/ANNUAL_EDITIONS.md text eol=lf
tests/fixtures/annual_2024/** -text

reference/schema/ANNUAL_SERIES.md text eol=lf
tests/fixtures/annual_series/** -text
reference/schema/ANNUAL_LEGACY.md text eol=lf
reference/schema/ANNUAL_COLON.md text eol=lf
tests/fixtures/annual_colon/** -text
