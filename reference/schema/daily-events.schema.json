{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/current-events-context/reference/schema/daily-events.schema.json",
  "title": "Daily Events Dataset",
  "description": "Schema 2.2 for an expanded daily current-events YAML file (e.g. 2026/01/2026-01-02.yaml), produced by enriching the Wikipedia Current Events portal bullets with a deep-research markdown report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "source_page",
    "dataset",
    "editorial_policy",
    "analytical_overview",
    "events",
    "strategic_conclusion",
    "works_cited"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of the day this file covers."
    },
    "source_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portal", "language", "wikipedia_revision_id"],
      "properties": {
        "portal": { "type": "string", "description": "e.g. 'Portal:Current events/2026 January 2'." },
        "language": { "type": "string", "default": "en" },
        "wikipedia_revision_id": { "type": ["integer", "null"] }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "compiler", "scope"],
      "properties": {
        "schema_version": { "type": "string", "const": "2.2" },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status", "reviewed"],
          "description": "status, reviewed, and the mode suffix all encode review state and must stay consistent (enforced by the allOf rules below): a 'draft' file is reviewed:false with mode '...snapshot'; a 'reviewed' file is reviewed:true with mode '...snapshot_reviewed'.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "llm_deep_research_broad_snapshot",
                "llm_deep_research_broad_snapshot_reviewed"
              ]
            },
            "status": { "type": "string", "enum": ["draft", "reviewed"] },
            "reviewed": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": { "required": ["status"], "properties": { "status": { "const": "reviewed" } } },
              "then": {
                "properties": {
                  "reviewed": { "const": true },
                  "mode": { "const": "llm_deep_research_broad_snapshot_reviewed" }
                }
              }
            },
            {
              "if": { "required": ["status"], "properties": { "status": { "const": "draft" } } },
              "then": {
                "properties": {
                  "reviewed": { "const": false },
                  "mode": { "const": "llm_deep_research_broad_snapshot" }
                }
              }
            }
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed_source", "enrichment_sources_expected"],
          "properties": {
            "seed_source": { "type": "string" },
            "enrichment_sources_expected": { "type": "boolean" }
          }
        }
      }
    },
    "editorial_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_style", "allow_inference", "require_source_support"],
      "properties": {
        "summary_style": { "type": "string" },
        "allow_inference": { "type": "boolean" },
        "require_source_support": { "type": "boolean" }
      }
    },
    "analytical_overview": {
      "type": "string",
      "description": "1-2 paragraph synthesis of the day, grounded in the events below."
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "strategic_conclusion": {
      "type": "string",
      "description": "Closing synthesis: cross-cutting themes and outlook, grounded in the events."
    },
    "works_cited": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/work" },
      "description": "Numbered bibliography. Every citation_refs integer used anywhere must resolve to a work id here."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "subcategory",
        "topics",
        "importance",
        "headline",
        "summary",
        "key_data",
        "details",
        "actors",
        "entities",
        "geography",
        "time",
        "casualty_report",
        "classification",
        "sources",
        "provenance",
        "confidence",
        "related_events",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evt-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$",
          "description": "evt-YYYY-MM-DD-NNN, NNN zero-padded, sequential from 001."
        },
        "category": {
          "type": "string",
          "description": "Top-level Wikipedia portal category. Common values: 'Armed conflicts and attacks', 'Business and economy', 'Disasters and accidents', 'Environment and climate', 'Law and crime', 'Politics and elections'. Open vocabulary — new values allowed."
        },
        "subcategory": { "type": "string" },
        "topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Short topic tags / linked-article titles."
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Editorial significance, 1 (minor) to 10 (historic)."
        },
        "headline": { "type": "string" },
        "summary": { "type": "string", "description": "Folded scalar (>) prose summary." },
        "key_data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "citation_refs"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" },
              "citation_refs": { "$ref": "#/$defs/citation_refs" }
            }
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what_happened", "why_it_matters", "uncertainty_notes"],
          "properties": {
            "what_happened": { "type": "array", "items": { "type": "string" } },
            "why_it_matters": { "type": "array", "items": { "type": "string" } },
            "uncertainty_notes": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Record disputed figures / conflicting reports here. Pair with source-level 'contradicts'."
            }
          }
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary"],
          "properties": {
            "primary": { "type": "array", "items": { "type": "string" } },
            "secondary": { "type": "array", "items": { "type": "string" } }
          }
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["people", "organizations", "states"],
          "properties": {
            "people": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "role"],
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" }
                }
              }
            },
            "organizations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "description"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "states": { "type": "array", "items": { "type": "string" } }
          }
        },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["countries", "places", "coordinates"],
          "properties": {
            "countries": { "type": "array", "items": { "type": "string" } },
            "places": { "type": "array", "items": { "type": "string" } },
            "coordinates": {
              "type": "array",
              "description": "Usually empty []. If present, items are {lat, lon} pairs.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lat", "lon"],
                "properties": {
                  "lat": { "type": "number" },
                  "lon": { "type": "number" }
                }
              }
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "time_known", "ongoing"],
          "properties": {
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "time_known": { "type": "boolean" },
            "time_detail": {
              "type": "string",
              "description": "Only present when time_known is true."
            },
            "ongoing": { "type": "boolean" }
          },
          "if": { "properties": { "time_known": { "const": true } } },
          "then": { "required": ["time_detail"] }
        },
        "casualty_report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["killed", "injured", "displaced", "missing", "arrest_count", "damage"],
          "properties": {
            "killed": { "type": ["integer", "null"], "minimum": 0 },
            "injured": { "type": ["integer", "null"], "minimum": 0 },
            "displaced": { "type": ["integer", "null"], "minimum": 0 },
            "missing": { "type": ["integer", "null"], "minimum": 0 },
            "arrest_count": { "type": ["integer", "null"], "minimum": 0 },
            "damage": { "type": ["string", "null"] }
          }
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_type", "tags"],
          "properties": {
            "event_type": { "type": "array", "items": { "type": "string" }, "description": "kebab-case type slugs." },
            "tags": { "type": "array", "items": { "type": "string" }, "description": "kebab-case free tags." }
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wikipedia_portal", "external"],
          "properties": {
            "wikipedia_portal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["included", "text_fragment"],
              "properties": {
                "included": {
                  "type": "boolean",
                  "description": "true if this event maps to a portal bullet; false for markdown-only events."
                },
                "text_fragment": {
                  "type": ["string", "null"],
                  "description": "The verbatim portal bullet text when included is true; null otherwise."
                }
              },
              "if": { "properties": { "included": { "const": true } } },
              "then": { "properties": { "text_fragment": { "type": "string" } } }
            },
            "external": {
              "type": "array",
              "description": "May be [] for portal-only events that were not enriched.",
              "items": { "$ref": "#/$defs/external_source" }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extracted_from_portal_bullet", "enriched_manually", "last_reviewed_by"],
          "properties": {
            "extracted_from_portal_bullet": { "type": "boolean" },
            "enriched_manually": { "type": "boolean" },
            "last_reviewed_by": { "type": ["string", "null"] }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["event_existence", "detail_accuracy", "actor_identification"],
          "properties": {
            "event_existence": { "$ref": "#/$defs/confidence_level" },
            "detail_accuracy": { "$ref": "#/$defs/confidence_level" },
            "actor_identification": { "$ref": "#/$defs/confidence_level" }
          }
        },
        "related_events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
          },
          "description": "Cross-references to other event ids (same or other day files)."
        },
        "notes": { "type": "string", "description": "Free text; \"\" if none." }
      }
    },
    "external_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outlet",
        "url",
        "publication_date",
        "source_type",
        "reliability_tier",
        "supports",
        "contradicts",
        "quoted_material",
        "citation_refs"
      ],
      "properties": {
        "id": { "type": "string", "description": "Local id, e.g. src-001-a." },
        "outlet": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "publication_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "source_type": {
          "type": "string",
          "enum": [
            "news_report",
            "official_release",
            "encyclopedia",
            "broadcast",
            "ngo_report",
            "advocacy_organization",
            "specialist_publication",
            "trade_publication"
          ]
        },
        "reliability_tier": { "type": "string", "enum": ["high", "medium", "low"] },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["summary", "key_data", "casualty_report", "details.what_happened", "details.why_it_matters"]
          }
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["summary", "key_data", "casualty_report", "details.what_happened", "details.why_it_matters"]
          },
          "description": "Fields this source disputes — used for conflicting casualty figures."
        },
        "quoted_material": { "type": "array", "items": { "type": "string" } },
        "citation_refs": { "$ref": "#/$defs/citation_refs" }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "outlet", "url", "accessed"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "outlet": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "citation_refs": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "description": "Integers referencing works_cited[].id."
    },
    "confidence_level": { "type": "string", "enum": ["high", "medium", "low"] }
  }
}
